; Engine configuration file.

config_version=5

[application]

config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

config/name="Fishus Maximus"
config/description="A cozy Roman fishing game on the Bay of Naples."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.1, 0.07, 0.09, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://assets/art/ui/boot_splash.png"

[autoload]

Dev="*res://scripts/autoload/dev.gd"
Data="*res://scripts/autoload/data.gd"
Settings="*res://scripts/autoload/settings.gd"
Game="*res://scripts/autoload/game_state.gd"
Saves="*res://scripts/autoload/saves.gd"
Nav="*res://scripts/autoload/nav.gd"
Tips="*res://scripts/autoload/tips.gd"
Pad="*res://scripts/autoload/pad.gd"
Awards="*res://scripts/autoload/awards.gd"
Windowing="*res://scripts/autoload/windowing.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="disabled"

[gui]

fonts/dynamic_fonts/use_oversampling=false
theme/default_font_antialiasing=0

[internationalization]

locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.1, 0.07, 0.09, 1)
